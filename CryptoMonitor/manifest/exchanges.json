        "base": "$.base_currency",
        "quote": "$.quote_currency",
        "symbolId": "$.symbol",
        "pricePrecision": "$.price_min_precision"
      },
      "ticker": {
        "mode": "bulk",
        "url": "https://api-cloud.bitmart.com/spot/quotation/v3/tickers",
        "rootPath": "$.data[*]",
        "matchOn": "$[0]",
        "fields": {
          "last": "$[1]",
          "volumeBase": "$[2]",
          "volumeQuote": "$[3]",
          "open24h": "$[4]",
          "high24h": "$[5]",
          "low24h": "$[6]",
          "changePercent24h": {
            "path": "$[7]",
            "scale": 100
          },
          "bid": "$[8]",
          "ask": "$[10]"
        },
        "single": {
          "url": "https://api-cloud.bitmart.com/spot/quotation/v3/ticker?symbol={symbol}",
          "rootPath": "$.data",
          "fields": {
            "last": "$.last",
            "volumeBase": "$.v_24h",
            "volumeQuote": "$.qv_24h",
            "open24h": "$.open_24h",
            "high24h": "$.high_24h",
            "low24h": "$.low_24h",
            "changePercent24h": {
              "path": "$.fluctuation",
              "scale": 100
            },
            "bid": "$.bid_px",
            "ask": "$.ask_px"
          },
          "timestampPath": "$.ts"
        }
      },
      "limits": {
        "requestsPerMinute": 120,
        "minRefreshSeconds": 3
      },
      "error": {
        "path": "$.message",
        "okWhen": {
          "path": "$.code",
          "equals": 1000
        }
      },
      "healthPin": true,
      "candles": {
        "url": "https://api-cloud.bitmart.com/spot/quotation/v3/klines?symbol={symbol}&step=15&after={startSec}&limit={limit}",
        "rootPath": "$.data[*]",
        "time": "$[0]",
        "timeUnit": "seconds",
        "open": "$[1]",
        "close": "$[4]",
        "stepMinutes": 15
      }
    },
