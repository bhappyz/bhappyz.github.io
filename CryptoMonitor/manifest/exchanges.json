          "bid": "$.bid",
          "ask": "$.ask",
          "high24h": "$.high",
          "low24h": "$.low",
          "volumeBase": "$.volume",
          "absoluteChange24h": "$.change_24"
        },
        "single": {
          "url": "https://api.bitso.com/v3/ticker/?book={symbol}",
          "rootPath": "$.payload"
        }
      },
